# Copy to .env and fill in. .env is git-ignored.

# --- Amadeus (Self-Service) ---
# Register a free app at https://developers.amadeus.com (no credit card).
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
# Test env (cached/limited fares) is the default. For live fares use a
# production key and set:
# AMADEUS_BASE_URL=https://api.amadeus.com

# --- Kiwi.com (Tequila) ---
# Create a free API key (no credit card) at
# https://tequila.kiwi.com/portal/login/apikeys
KIWI_API_KEY=your-kiwi-tequila-apikey
