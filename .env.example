# Copy to .env and fill in. .env is git-ignored.

# --- Amadeus (Self-Service) ---
# Register a free app at https://developers.amadeus.com (no credit card).
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
# Test env (cached/limited fares) is the default. For live fares use a
# production key and set:
# AMADEUS_BASE_URL=https://api.amadeus.com





# --- Kiwi.com (Tequila) ---
# Create a free API key (no credit card) at
# https://tequila.kiwi.com/portal/login/apikeys
KIWI_API_KEY=your-kiwi-tequila-apikey

# --- Duffel ---
# Create a free account (no card) at https://app.duffel.com and copy an
# access token. Test tokens (duffel_test_...) return sandbox content; live
# tokens (duffel_live_...) return real airline + NDC fares.
DUFFEL_API_TOKEN=your-duffel-access-token
# Optional overrides:
# DUFFEL_VERSION=v2
# DUFFEL_BASE_URL=https://api.duffel.com

# --- SerpApi (Google Flights) ---
# Real, current Google Flights fares as structured JSON (licensed, no scraping).
# Free key (~100 searches/month, no card) at https://serpapi.com/users/sign_up
SERPAPI_API_KEY=your-serpapi-key
